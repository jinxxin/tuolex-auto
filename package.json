{
  "name": "tuolex-auto-community",
  "version": "0.1.0",
  "private": true,
  "description": "tuoleX auto — self-hosted automotive software process and evidence management (A-SPICE / ISO 26262 basis). 开源自托管的汽车软件过程与证据管理工具。",
  "license": "Apache-2.0",
  "author": "Jin Xin <jinxxin@live.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinxxin/tuolex-auto.git"
  },
  "bugs": {
    "url": "https://github.com/jinxxin/tuolex-auto/issues"
  },
  "homepage": "https://tuolex.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "a-spice",
    "aspice",
    "iso-26262",
    "functional-safety",
    "traceability",
    "self-hosted"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-i18n-keys.mjs && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "i18n:scan": "node scripts/en-scan.mjs",
    "test:fs": "tsx --test src/core/fs/asil.test.ts src/core/fs/chain.test.ts src/core/fs/fsPacks.test.ts src/core/tq/tcl.test.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "antd": "^6.7.2",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "diff": "^9.0.0",
    "docx": "^9.16.0",
    "echarts": "^6.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "marked": "^18.3.0",
    "occt-import-js": "^0.0.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.6",
    "three": "^0.187.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.95.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
