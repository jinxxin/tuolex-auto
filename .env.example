# ===== tuoleX auto 社区版 · 环境变量示例 =====
# 复制为 .env 后按需修改；不要提交真实密钥。

# 对外端口（浏览器访问）
WEB_PORT=8087

# 数据库密码（生产必改）
POSTGRES_PASSWORD=tuolex

# 会话签名密钥（生产必填；留空则每次启动随机生成，重启后登录态失效）
# 生成：openssl rand -hex 32
JWT_SECRET=

# 允许的前端来源（逗号分隔；默认与 WEB_PORT 一致）
# CORS_ORIGINS=http://localhost:8087

# 演示数据：首次启动是否灌入一个虚构的演示项目（true/false）
SEED_DEMO=true
